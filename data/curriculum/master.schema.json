{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-learning.local/schemas/curriculum-master.schema.json",
  "title": "APEX Curriculum Master",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "gradeLevel", "courses"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "gradeLevel": { "type": "string", "enum": ["SD", "SMP", "SMK"] },
    "locale": { "type": "string", "default": "id-ID" },
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "modules"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "modules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "sequenceOrder", "lessons"],
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "sequenceOrder": { "type": "integer", "minimum": 1 },
                "masteryThreshold": { "type": "number", "minimum": 0, "maximum": 100 },
                "meta": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "phase": { "type": "string" },
                    "subject": { "type": "string" },
                    "track": { "type": "string" },
                    "gradeLevel": { "type": "string" }
                  }
                },
                "lessons": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["title", "type"],
                    "properties": {
                      "title": { "type": "string", "minLength": 1 },
                      "type": { "type": "string", "enum": ["VIDEO", "ARTICLE", "INTERACTIVE"] },
                      "contentUrl": { "type": "string" },
                      "meta": {
                        "type": "object",
                        "additionalProperties": true,
                        "properties": {
                          "code": { "type": ["string", "null"] },
                          "topic": { "type": ["string", "null"] },
                          "benchmark": { "type": ["string", "null"] }
                        }
                      },
                      "quiz": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["questions"],
                        "properties": {
                          "questions": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "object",
                              "additionalProperties": true,
                              "required": ["question", "options", "answerIndex", "tags"],
                              "properties": {
                                "question": { "type": "string", "minLength": 1 },
                                "options": {
                                  "type": "array",
                                  "minItems": 2,
                                  "items": { "type": "string", "minLength": 1 }
                                },
                                "answerIndex": { "type": "integer", "minimum": 0 },
                                "explanation": { "type": "string" },
                                "tags": {
                                  "type": "array",
                                  "items": { "type": "string", "minLength": 1 }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
