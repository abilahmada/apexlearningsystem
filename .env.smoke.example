# Integration smoke test for lesson-assessment PRE gating.
# Copy this file to .env.local (or export manually) before running:
# npm run test:lesson-assessment:smoke

# Base URL where app is running (local dev / staging).
APEX_SMOKE_BASE_URL=http://localhost:3000

# Student bearer token from Supabase Auth (access_token).
APEX_SMOKE_TOKEN=

# Lesson UUID that has quiz but PRE has not been submitted by this student.
APEX_SMOKE_LESSON_ID=

# Optional idempotency key for POST smoke call.
APEX_SMOKE_SUBMIT_KEY=smoke-pre-required

